{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,

    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Resolve the package to its source, so typechecking doesn't need a build.
    // Keep in sync with the aliases in playground/vite.config.ts.
    "paths": {
      "comark-pele": ["./src/index.ts"],
      "comark-pele/angular": ["./src/angular/index.ts"],
      "comark-pele/svelte": ["./src/svelte/index.ts"],
      "comark-pele/react": ["./src/react.tsx"],
      "comark-pele/*": ["./src/*.ts"]
    }
  },
  "include": ["src", "test", "playground", "vitest.config.ts"]
}
