{
  "name": "comark-pele",
  "version": "0.0.0",
  "description": "Render Mermaid diagrams in Comark with Pele: a parse plugin plus components for HTML, ANSI, Vue, React, Svelte, and Angular",
  "keywords": [
    "comark",
    "markdown",
    "mdc",
    "plugin",
    "mermaid",
    "pele",
    "diagram",
    "svg",
    "vue",
    "react",
    "svelte",
    "angular"
  ],
  "homepage": "https://github.com/farnabaz/comark-pele#readme",
  "bugs": {
    "url": "https://github.com/farnabaz/comark-pele/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farnabaz/comark-pele.git"
  },
  "author": "Farnabaz",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./render": {
      "types": "./dist/render.d.mts",
      "default": "./dist/render.mjs"
    },
    "./html": {
      "types": "./dist/html.d.mts",
      "default": "./dist/html.mjs"
    },
    "./ansi": {
      "types": "./dist/ansi.d.mts",
      "default": "./dist/ansi.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "default": "./dist/vue.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm build:svelte && pnpm build:angular",
    "build:svelte": "svelte-package --input src/svelte --output dist/svelte",
    "build:angular": "ngc -p tsconfig.angular.json && node scripts/verify-angular.mjs",
    "dev": "tsdown --watch",
    "play": "vite --config playground/vite.config.ts",
    "play:build": "vite build --config playground/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "comark": ">=0.7.0",
    "pele": "^1.5.0",
    "react": ">=18.0.0",
    "svelte": "^5.20.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@comark/angular": "0.7.0",
    "@comark/ansi": "0.7.0",
    "@comark/html": "0.7.0",
    "@comark/react": "0.7.0",
    "@comark/svelte": "0.7.0",
    "@comark/vue": "0.7.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "comark": "^0.7.0",
    "happy-dom": "^21.0.3",
    "pele": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^21.1.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.44"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  }
}
